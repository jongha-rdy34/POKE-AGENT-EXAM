# judge-eval/.env 로 복사해서 채운다. .env는 git에 올리지 않는다(.gitignore).
# 두 앱과 Gemini 판정이 같은 키를 쓴다(무료 플랜, 한도 공유). gemini-3.5-flash는 3.6 Flash 한도: RPM 5, RPD 20, TPM 250K (STATUS-2026-11-27.md 6절)
GEMINI_API_KEY=
GEMINI_OPENAI_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
APP_LLM_MODEL=gemini-3.5-flash
# Gemini 판정: 모델:회차수:호출간격초. flash-lite 7 : flash 3 (2026-11-27 결정). 한 회차 = 판정 4건
JUDGE_GEMINI_PLAN=gemini-3.5-flash-lite:7:6,gemini-3.5-flash:3:20
JUDGE_TEMPERATURE=0.2
# A 접속용 임의 토큰(이름표:비밀값). 친구 테스트 토큰을 쓰지 않는다
A_INVITE_TOKENS=eval:change-me
# 가상환경 경로(비우면 저장소 옆 ../venvs/A, ../venvs/B). Windows 예: C:\Users\<이름>\AppData\Local\POKE-AGENT-EXAM\venvs\A
VENV_A=
VENV_B=
